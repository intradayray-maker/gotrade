{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
"include": [
  "next-env.d.ts",
  "app",
  "components",
  "utils",
  "**/*.ts",
  "**/*.tsx",
  "app/globals.css",
  ".next/types/**/*.ts"
]
,
  "exclude": ["node_modules"]
}
